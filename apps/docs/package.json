{
  "name": "@marcusok/docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Public documentation site for marcusok packages (VitePress, en-US default + zh).",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vitepress dev --port 5174",
    "build": "vitepress build",
    "preview": "vitepress preview --port 4174",
    "lint": "eslint .vitepress src env.d.ts && node --check scripts/check-i18n.mjs",
    "typecheck": "vue-tsc --noEmit",
    "check-i18n": "node scripts/check-i18n.mjs",
    "test": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@marcusok/excel-exporter": "workspace:*",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "eslint-plugin-vue": "^10.10.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
