{
  "name": "@marcusok/word-preview",
  "version": "0.1.2",
  "type": "module",
  "description": "Read-only docx preview in the browser: visual-faithful Word rendering powered by docx-preview, with format sniffing, hardened defaults (altChunks off, hyperlink scheme allowlist) and multi-instance style isolation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourbusiness/marcusok.git",
    "directory": "packages/word-preview"
  },
  "bugs": {
    "url": "https://github.com/yourbusiness/marcusok/issues"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "word",
    "docx",
    "preview",
    "viewer",
    "docx-preview"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "docx-preview": "0.4.1",
    "eslint": "^9.16.0",
    "fflate": "^0.8.3",
    "happy-dom": "^20.14.5",
    "jszip": "3.10.1",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
